# user-svc base — no trailing path segment: the client appends
# /user/login, /users/me, /users/lookup and so on.
NEXT_PUBLIC_USER_SVC_URL="http://localhost:8080/user-svc-smm/api/v1"

# puckoops-be base — no trailing path segment: the client appends /nodes,
# /uploads/init, /quota and so on.
NEXT_PUBLIC_PUCKOOPS_BE_URL="http://localhost:8082/puckoops-be/api/v1"
